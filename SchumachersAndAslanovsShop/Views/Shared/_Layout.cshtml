@using Microsoft.AspNetCore.Http
@using Microsoft.EntityFrameworkCore
@inject SchumachersAndAslanovsShop.Data.AppDbContext _context

@{
    int? userId = Context.Session.GetInt32("UserId");
    int cartCount = 0;
    if (userId != null)
    {
        cartCount = _context.ShoppingCarts.Count(c => c.UserId == userId.Value);
    }
}

<!DOCTYPE html><html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Schumacher & Aslanov</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchumachersAndAslanovsShop.styles.css" asp-append-version="true" />

    <style>
        /* Стили для ИИ чата */
        #Chat-bot { position: fixed; bottom: 20px; right: 20px; width: 320px; z-index: 1000; transition: 0.3s; }
        #chat-window { height: 250px; overflow-y: auto; font-size: 14px; background: #f8f9fa; display: flex; flex-direction: column; }
        .ai-msg { background: #007bff; color: white; border-radius: 15px 15px 15px 0; padding: 8px 12px; margin-bottom: 10px; align-self: flex-start; max-width: 80%; }
        .user-msg { background: #e9ecef; color: #333; border-radius: 15px 15px 0 15px; padding: 8px 12px; margin-bottom: 10px; align-self: flex-end; max-width: 80%; }
        #chat-body-collapse.collapse:not(.show) { display: none; }
    </style>
</head>
<body>

    <div id="Chat-bot">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center" 
                 style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#chat-body-collapse">
                <span class="fw-bold"><i class="bi bi-robot me-2"></i>AI Car Assistant</span>
                <i class="bi bi-chevron-down"></i>
            </div>
            <div id="chat-body-collapse" class="collapse show">
                <div id="chat-window" class="card-body p-3">
                    <div class="ai-msg">Hello! I'm your AI assistant. How can I help you with cars today? 🏎️</div>
                </div>
                <div class="card-footer bg-white border-0">
                    <div class="input-group">
                        <input type="text" id="user-input-msg" class="form-control" placeholder="Ask something...">
                        <button onclick="askAI()" class="btn btn-danger"><i class="bi bi-send"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏎️ Schumacher & Aslanov</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-warning fw-bold" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link text-warning fw-bold" asp-controller="Catalog" asp-action="Cars">Car Catalog</a></li>
                        <li class="nav-item"><a class="nav-link text-warning fw-bold" asp-controller="Parts" asp-action="Categories">Spare Parts</a></li>
                    </ul>
                    <div class="d-flex align-items-center ms-auto">
                        @if (Context.Session.GetString("Username") != null)
                        {
                            <div class="dropdown me-3">
                                <button class="btn btn-outline-light dropdown-toggle fw-bold" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-fill text-success me-1"></i> Welcome, @Context.Session.GetString("Username")!
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow">
                                    <li><a class="dropdown-item py-2 fw-bold" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-2"></i> Profile</a></li>
                                    @if (Context.Session.GetString("UserRole") == "Admin" || Context.Session.GetString("UserRole") == "Moder")
                                    {
                                        <li><hr class="dropdown-divider border-secondary"></li>
                                        <li><a class="dropdown-item text-info fw-bold" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-shield-lock-fill me-2"></i> Admin Panel</a></li>
                                    }
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li><a class="dropdown-item" asp-controller="Orders" asp-action="MyOrders"><i class="bi bi-box-seam me-2"></i> My Orders</a></li>
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li><a class="dropdown-item text-danger fw-bold" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success fw-bold me-3">Sign In</a>
                        }
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-dark position-relative p-0 d-flex align-items-center justify-content-center" style="border-radius: 50%; width: 45px; height: 45px; border: 1px solid #444;">
                            <i class="bi bi-cart3 text-white" style="font-size: 1.3rem;"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.7rem;">@cartCount</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">@RenderBody()</main>
    </div>

    <footer class="border-top footer text-muted bg-light mt-5 text-center py-3">
        &copy; 2026 - SchumachersAndAslanovsShop - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        function askAI() {
            let msg = $('#user-input-msg').val();
            if (!msg) return;

            $('#chat-window').append(`<div class="user-msg">${msg}</div>`);
            $('#user-input-msg').val('');
            $('#chat-window').scrollTop($('#chat-window')[0].scrollHeight);

            $.ajax({
                url: '/AI/Ask',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(msg),
                success: function(data) {
                    $('#chat-window').append(`<div class="ai-msg">${data.response}</div>`);
                    $('#chat-window').scrollTop($('#chat-window')[0].scrollHeight);
                },
                error: function() {
                    $('#chat-window').append(`<div class="ai-msg bg-secondary">System offline. Try again later.</div>`);
                }
            });
        }
        $('#user-input-msg').keypress(function(e){ if(e.which == 13) askAI(); });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>