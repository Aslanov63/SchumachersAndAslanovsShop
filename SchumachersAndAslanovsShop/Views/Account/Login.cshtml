@model SchumachersAndAslanovsShop.Models.User

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 400px;">
        <h2 class="text-center mb-4">Login</h2>
        
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label class="form-label">Username</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input name="username" class="form-control" placeholder="Enter nickname" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input name="password" type="password" class="form-control" placeholder="Enter password" required />
                </div>
            </div>

            <button type="submit" class="btn btn-success w-100 fw-bold">Login</button>
        </form>
        
        <div class="text-center mt-3">
            <span>New here? </span><a asp-action="Register" class="text-decoration-none">Create an account</a>
        </div>
    </div>
</div>