@model SchumachersAndAslanovsShop.Models.Car

<div class="container mt-5">
    <div class="row shadow-lg rounded-4 overflow-hidden bg-white">
        <div class="col-md-6 p-0">
            <img src="@Model.CarImageUrl" class="img-fluid h-100" style="object-fit: cover; min-height: 500px;" alt="@Model.CarModel">
        </div>

        <div class="col-md-6 p-5">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="badge bg-primary mb-2">@Model.Category?.Name</span>
                    <h1 class="fw-bold mb-0">@Model.CarBrand @Model.CarModel</h1>
                    <p class="text-muted fs-5">Year: @Model.CarYear | @Model.CarEngine</p>
                </div>
                <h2 class="text-danger fw-bold">@Model.Price.ToString("N0") $</h2>
            </div>

            <hr class="my-4">

            @if (Model.Description != null)
            {
                <h4 class="fw-bold mb-3">Technical Details</h4>
                <div class="row g-3">
                    <div class="col-6">
                        <ul class="list-unstyled">
                            <li class="mb-2"><strong>Transmission:</strong> @Model.Description.Transmission</li>
                            <li class="mb-2"><strong>Wheel Drive:</strong> @Model.Description.WheelDrive</li>
                            <li class="mb-2"><strong>Engine Type:</strong> @Model.Description.EngineType</li>
                            <li class="mb-2"><strong>Volume:</strong> @Model.Description.EngineVolume L</li>
                        </ul>
                    </div>
                    <div class="col-6">
                        <ul class="list-unstyled">
                            <li class="mb-2"><strong>Interior:</strong> @Model.Description.InteriorColor</li>
                            <li class="mb-2"><strong>A/C:</strong> @(Model.Description.Ac == 1 ? "Available" : "Not available")</li>
                            <li class="mb-2"><strong>Prev. Owners:</strong> @Model.Description.OwnersBefore</li>
                            <li class="mb-2"><strong>Mileage:</strong> @Model.CarMilage km</li>
                        </ul>
                    </div>
                </div>

                <div class="mt-4 p-3 rounded bg-light border">
                    <h6 class="fw-bold">Vehicle History:</h6>
                    <div class="d-flex gap-2">
                        <span class="badge @(Model.Description.Crashed == 1 ? "bg-danger" : "bg-success")">
                            <i class="bi @(Model.Description.Crashed == 1 ? "bi-exclamation-triangle" : "bi-check-circle") me-1"></i>
                            @(Model.Description.Crashed == 1 ? "Has been in accidents" : "No accidents")
                        </span>
                        <span class="badge @(Model.Description.Painted == 1 ? "bg-warning text-dark" : "bg-success")">
                            <i class="bi bi-paint-bucket me-1"></i>
                            @(Model.Description.Painted == 1 ? "Repainted elements" : "Original paint")
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">Detailed information is being updated.</div>
            }

            <div class="mt-5 d-grid gap-2">
                <form asp-controller="Orders" asp-action="OrderCar" method="post">
                    <input type="hidden" name="carId" value="@Model.CarId" />
                    <input type="hidden" name="price" value="@Model.Price" />
                    <button type="submit" class="btn btn-dark btn-lg w-100 py-3 shadow">
                        Confirm Order
                    </button>
                </form>
                <a asp-action="Cars" class="btn btn-link text-muted mt-2">Back to Catalog</a>
            </div>
        </div>
    </div>
</div>