@model SchumachersAndAslanovsShop.Models.Order

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-receipt text-primary me-2"></i>Order #@Model.Id</h2>
        <a asp-action="MyOrders" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Back to History
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-4">
                    @if (Model.Car != null)
                    {
                        <div class="row">
                            <div class="col-md-5">
                                <img src="@Model.Car.CarImageUrl" class="img-fluid rounded-3 shadow-sm mb-3" alt="Car">
                                <div class="bg-primary bg-opacity-10 p-3 rounded-3">
                                    <h6 class="text-primary fw-bold mb-1">Final Price Paid:</h6>
                                    <h4 class="fw-bold mb-0">$@Model.TotalPrice.ToString("N2")</h4>
                                </div>
                            </div>
                            <div class="col-md-7">
                                <h3 class="fw-bold text-dark mb-0">@Model.Car.CarBrand @Model.Car.CarModel</h3>
                                <p class="text-muted">Production Year: @Model.Car.CarYear</p>
                                
                                <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-info-circle me-2"></i>Technical Specification</h5>
                                <div class="row g-3">
                                    @if (Model.Car.Description != null)
                                    {
                                        <div class="col-6">
                                            <small class="text-muted d-block">Transmission</small>
                                            <span class="fw-bold">@Model.Car.Description.Transmission</span>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted d-block">Wheel Drive</small>
                                            <span class="fw-bold">@Model.Car.Description.WheelDrive</span>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted d-block">Engine</small>
                                            <span class="fw-bold">@Model.Car.Description.EngineType (@Model.Car.Description.EngineVolume L)</span>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted d-block">Interior Color</small>
                                            <span class="fw-bold">@Model.Car.Description.InteriorColor</span>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted d-block">Owners Before</small>
                                            <span class="fw-bold">@Model.Car.Description.OwnersBefore</span>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted d-block">Condition</small>
                                            <span class="badge @(Model.Car.Description.Crashed == 1 ? "bg-danger" : "bg-success")">
                                                @(Model.Car.Description.Crashed == 1 ? "Was Damaged" : "No Accidents")
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-12 text-muted italic">Technical details are currently unavailable.</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <h4 class="fw-bold mb-4">Spare Parts List</h4>
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.Part?.PartName</div>
                                            <small class="text-muted">Part ID: #@item.PartId</small>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end fw-bold">$@item.PriceAtPurchase.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3">Order Status</h5>
                <div class="d-flex align-items-center mb-4">
                    <div class="flex-shrink-0 bg-success p-3 rounded-circle text-white me-3">
                        <i class="bi bi-check-lg fs-4"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-5">Confirmed</div>
                        <small class="text-muted">@Model.OrderDate.ToString("f")</small>
                    </div>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Payment:</span>
                    <span class="fw-bold">Online Card</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Total:</span>
                    <span class="fw-bold text-primary fs-4">$@Model.TotalPrice.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
</div>