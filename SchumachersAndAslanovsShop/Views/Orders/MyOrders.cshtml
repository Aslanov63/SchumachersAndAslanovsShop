@model IEnumerable<SchumachersAndAslanovsShop.Models.Order>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-clock-history text-primary me-2"></i>My Order History</h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Return to Shop</a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4 py-3">Order ID</th>
                        <th>Date</th>
                        <th>Order Type</th>
                        <th class="text-center">Status</th>
                        <th>Total Price</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">#@order.Id</td>
                            <td class="text-muted">@order.OrderDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (order.Car != null)
                                {
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-car-front-fill text-primary me-2"></i>
                                        <span>@order.Car.CarBrand @order.Car.CarModel</span>
                                    </div>
                                }
                                else if (order.OrderItems != null && order.OrderItems.Any())
                                {
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-tools text-success me-2"></i>
                                        <span>Spare Parts (@order.OrderItems.Count items)</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">No details</span>
                                }
                            </td>

                            <td class="text-center">
                                @if (order.Status == "1" || order.Status == "Pending")
                                {
                                    <span class="badge rounded-pill bg-success px-3">Pending</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary px-3">@order.Status</span>
                                }
                            </td>

                            <td class="fw-bold text-dark">
                                $@order.TotalPrice.ToString("N2")
                            </td>

                            <td class="text-center">
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                                       class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm">
                                    <i class="bi bi-eye-fill me-1"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table thead th {
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .table tbody tr {
        transition: background-color 0.2s ease;
    }

    .btn-primary {
        background-color: #0d6efd;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0b5ed7;
            transform: translateY(-1px);
        }
</style>