@model IEnumerable<SchumachersAndAslanovsShop.Models.Part>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3">
        <h1 class="display-6 fw-bold">Spare Parts</h1>
        <span class="badge bg-danger">Schumacher & Aslanov Quality</span>
    </div>

    @if (ViewBag.CategoryName != null)
    {
        <nav aria-label="breadcrumb" class="mt-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Categories">All Categories</a></li>
                <li class="breadcrumb-item active">@ViewBag.CategoryName</li>
            </ol>
        </nav>
    }

    <div class="row mb-4 mt-4">
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex shadow-sm">
                <input type="hidden" name="categoryId" value="@ViewBag.CurrentCategory" />
                
                <input type="text" name="searchString" class="form-control border-dark"
                       placeholder="Search for parts (e.g. Bosch, Brake, Audi)..."
                       value="@ViewBag.CurrentSearch" />
                
                <button type="submit" class="btn btn-dark ms-1">
                    Search
                </button>

                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
                {
                    <a asp-action="Index" asp-route-categoryId="@ViewBag.CurrentCategory" class="btn btn-outline-secondary ms-1">
                        Reset
                    </a>
                }
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No parts found matching your criteria.
                        </td>
                    </tr>
                }
                @foreach (var part in Model)
                {
                    <tr>
                        <td>#@part.PartId</td>
                        <td><span class="fw-bold">@part.PartName</span></td>
                        <td>@(part.Category?.CategoryName ?? "No category")</td>
                        <td class="fw-bold">@part.PartPrice.ToString("N2") EUR</td>
                        <td><span class="text-success">● Available</span></td>
                        <td class="text-center">
                            <div class="btn-group">
                                
                                
                                
                                <a asp-controller="Cart" asp-action="AddToCart" asp-route-partId="@part.PartId"
                                       class="btn btn-sm btn-success">
                                    🛒 Add To Cart
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>