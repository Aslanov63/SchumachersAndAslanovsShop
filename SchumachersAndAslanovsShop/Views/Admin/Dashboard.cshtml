@model IEnumerable<SchumachersAndAslanovsShop.Models.Order>
@using Microsoft.AspNetCore.Http

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark">Management Dashboard</h2>
            <p class="text-muted small">Welcome to the shop control center</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="bi bi-box-arrow-left"></i> Back to Site
        </a>
    </div>

    <div class="row g-3 mb-5">
        
        @* Проверка: кнопку управления персоналом видит ТОЛЬКО Admin *@
        @if (Context.Session.GetString("UserRole") == "Admin")
        {
            <div class="col-6 col-md-3">
                <a asp-action="Staff" class="card h-100 text-decoration-none shadow-sm border-0 bg-danger text-white hover-card">
                    <div class="card-body text-center py-4">
                        <i class="bi bi-shield-lock-fill fs-1 mb-2"></i>
                        <h5 class="card-title mb-0 small fw-bold text-uppercase">Staff Control</h5>
                        <small class="opacity-75">Manage roles</small>
                    </div>
                </a>
            </div>
        }

        <div class="col-6 col-md-3">
            <a asp-action="ManageCars" class="card h-100 text-decoration-none shadow-sm border-0 bg-dark text-white hover-card">
                <div class="card-body text-center py-4">
                    <i class="bi bi-collection-fill fs-1 mb-2 text-primary"></i>
                    <h5 class="card-title mb-0 small fw-bold text-uppercase">Manage Cars</h5>
                    <small class="text-white-50">Add, Edit, Delete</small>
                </div>
            </a>
        </div>

        <div class="col-6 col-md-3">
            <a asp-action="ManageParts" class="card h-100 text-decoration-none shadow-sm border-0 bg-dark text-white hover-card">
                <div class="card-body text-center py-4">
                    <i class="bi bi-tools fs-1 mb-2 text-success"></i>
                    <h5 class="card-title mb-0 small fw-bold text-uppercase">Manage Parts</h5>
                    <small class="text-white-50">Full inventory</small>
                </div>
            </a>
        </div>

        <div class="col-6 col-md-3">
            <a asp-action="OrderDashboard" class="card h-100 text-decoration-none shadow-sm border-0 bg-primary text-white hover-card">
                <div class="card-body text-center py-4">
                    <i class="bi bi-receipt fs-1 mb-2"></i>
                    <h5 class="card-title mb-0 small fw-bold text-uppercase">View Orders</h5>
                    <small class="opacity-75">Recent sales</small>
                </div>
            </a>
        </div>
    </div>

    <div id="ordersTable" class="card shadow-sm border-0 mb-5 rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-list-ul me-2 text-primary"></i>Recent Orders</h5>
            <span class="badge bg-light text-dark border rounded-pill px-3">Total: @Model.Count()</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4 py-3">Order ID</th>
                        <th>Item Details</th>
                        <th>Total Amount</th>
                        <th>Date</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@order.Id</td>
                                <td>
                                    @if (order.Car != null)
                                    {
                                        <span class="d-block text-dark fw-bold" style="font-size: 0.9rem;">@order.Car.CarBrand @order.Car.CarModel</span>
                                        <small class="text-muted"><i class="bi bi-car-front me-1"></i>Vehicle Order</small>
                                    }
                                    else
                                    {
                                        <span class="d-block text-dark fw-bold" style="font-size: 0.9rem;">Spare Parts Bundle</span>
                                        <small class="text-muted"><i class="bi bi-gear-wide-connected me-1"></i>Parts Order</small>
                                    }
                                </td>
                                <td class="text-dark fw-bold">$@order.TotalPrice.ToString("N2")</td>
                                <td class="small text-muted">@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-center">
                                    @{
                                        // Логика отображения статуса как в MyOrders
                                        var badgeClass = order.Status switch {
                                            "1" => "bg-success", // Зеленый для новых/оплаченных (как на твоих скринах)
                                            "Completed" => "bg-success",
                                            "Canceled" => "bg-danger",
                                            "Shipped" => "bg-info text-dark",
                                            _ => "bg-warning text-dark"
                                        };
                                        var statusDisplay = order.Status == "1" ? "Pending" : order.Status;
                                    }
                                    <span class="badge rounded-pill @badgeClass px-3" style="font-size: 0.75rem; min-width: 80px;">
                                        @statusDisplay
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No orders yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: all 0.25s ease;
        cursor: pointer;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.2) !important;
        filter: brightness(1.1);
    }

    /* Исправление ссылок */
    a.card { color: inherit; }
    a.card:hover { color: white; }

    .table tbody tr {
        transition: background-color 0.2s;
    }
</style>