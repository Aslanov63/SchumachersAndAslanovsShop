@model IEnumerable<SchumachersAndAslanovsShop.Models.Order>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-cart-check me-2"></i>Manage Orders</h2>
        <span class="badge bg-secondary">Total: @Model.Count()</span>
    </div>

    <div class="card shadow-sm border-0 mb-4 p-3 bg-light">
        <form method="get" asp-action="OrderDashboard" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold">User Search</label>
                <input type="text" name="searchTerm" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by User ID...">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Order Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="New" selected="@(ViewBag.CurrentStatus == "New")">New</option>
                    <option value="Processing" selected="@(ViewBag.CurrentStatus == "Processing")">Processing</option>
                    <option value="Shipped" selected="@(ViewBag.CurrentStatus == "Shipped")">Shipped</option>
                    <option value="Completed" selected="@(ViewBag.CurrentStatus == "Completed")">Completed</option>
                    <option value="Canceled" selected="@(ViewBag.CurrentStatus == "Canceled")">Canceled</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Apply Filter
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="OrderDashboard" class="btn btn-outline-secondary w-100">Reset</a>
            </div>
        </form>
    </div>

    <div class="card shadow-sm border-0 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark border-0">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th style="width: 200px;">Status Change</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr class="order-row" style="cursor: pointer;">
                        <td class="ps-4 fw-bold text-primary">#@order.Id</td>
                        <td class="text-muted">@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (order.Car != null)
                            {
                                <span class="badge bg-outline-dark border text-dark font-monospace"><i class="bi bi-car-front"></i> CAR</span>
                            }
                            else
                            {
                                <span class="badge bg-outline-dark border text-dark font-monospace"><i class="bi bi-tools"></i> PARTS</span>
                            }
                        </td>
                        <td class="fw-bold text-success">$@order.TotalPrice.ToString("N2")</td>
                        <td>
                            @* Форма смены статуса прямо в таблице *@
                            <form asp-action="UpdateOrderStatus" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <select name="newStatus" onchange="this.form.submit()" class="form-select form-select-sm border-primary">
                                    <option value="New" selected="@(order.Status == "New")">New</option>
                                    <option value="Processing" selected="@(order.Status == "Processing")">Processing</option>
                                    <option value="Shipped" selected="@(order.Status == "Shipped")">Shipped</option>
                                    <option value="Completed" selected="@(order.Status == "Completed")">Completed</option>
                                    <option value="Canceled" selected="@(order.Status == "Canceled")">Canceled</option>
                                </select>
                            </form>
                        </td>
                        <td class="text-center">
                            @* Ссылка на детали *@
                            <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-info text-white shadow-sm px-3 rounded-pill">
                                <i class="bi bi-eye-fill me-1"></i> Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .order-row:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
        transition: 0.2s;
    }

    .table thead th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }
</style>