@model SchumachersAndAslanovsShop.Models.Order
@{
    ViewData["Title"] = "Full Order Record";
}

<div class="container mt-4 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase border-start border-primary border-4 ps-3">
            Order Management <span class="text-muted">#@Model.Id</span>
        </h2>
        <a asp-action="OrderDashboard" class="btn btn-outline-dark shadow-sm">
            <i class="bi bi-arrow-left-circle me-1"></i> Back to Dashboard
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Customer Profile</h5>
                </div>
                <div class="card-body">
                    @if (Model.User != null)
                    {
                        <div class="text-center mb-3">
                            <div class="display-6 text-primary"><i class="bi bi-person-circle"></i></div>
                            <h4 class="fw-bold mb-0">@Model.User.Name @Model.User.Surname</h4>
                            <span class="badge bg-info text-dark">@Model.User.UserRole</span>
                        </div>
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Username:</span> <strong>@Model.User.Username</strong>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Email:</span> <strong>@Model.User.Gmail</strong>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Phone:</span> <strong>@Model.User.TelNumber</strong>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <div class="alert alert-warning m-0">User info unavailable</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-info-square me-2"></i>Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-sm-6">
                            <p class="text-muted mb-1">Total Transaction Amount</p>
                            <h2 class="text-success fw-bold">$@Model.TotalPrice.ToString("N2")</h2>
                            <p class="small text-muted">Placed: @Model.OrderDate.ToString("F")</p>
                        </div>
                        <div class="col-sm-6 border-start ps-4">
                            <form asp-action="UpdateOrderStatus" method="post">
                                <input type="hidden" name="orderId" value="@Model.Id" />
                                <label class="form-label fw-bold text-primary">Modify Status</label>
                                <div class="input-group">
                                    <select name="newStatus" class="form-select border-primary">
                                        <option value="New" selected="@(Model.Status == "New")">New</option>
                                        <option value="Processing" selected="@(Model.Status == "Processing")">Processing</option>
                                        <option value="Shipped" selected="@(Model.Status == "Shipped")">Shipped</option>
                                        <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                                        <option value="Canceled" selected="@(Model.Status == "Canceled")">Canceled</option>
                                    </select>
                                    <button type="submit" class="btn btn-primary">Update</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Car != null)
        {
            <div class="col-12">
                <div class="card shadow-sm border-0 overflow-hidden border-start border-warning border-5">
                    <div class="row g-0">
                        <div class="col-md-4">
                            <img src="@Model.Car.CarImageUrl" class="img-fluid h-100 w-100" style="object-fit: cover;" alt="Car">
                        </div>
                        <div class="col-md-8 p-4">
                            <h4 class="fw-bold text-uppercase">@Model.Car.CarBrand @Model.Car.CarModel</h4>
                            <div class="row mt-3">
                                <div class="col-md-3">
                                    <div class="small text-muted fw-bold text-uppercase">Year</div>
                                    <div class="fs-5">@Model.Car.CarYear</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="small text-muted fw-bold text-uppercase">Mileage</div>
                                    @* ИСПРАВЛЕНИЕ: Просто выводим строку, если это не число *@
                                    <div class="fs-5">@Model.Car.CarMilage km</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="small text-muted fw-bold text-uppercase">Price</div>
                                    <div class="fs-5 text-primary fw-bold">$@Model.Car.Price.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.OrderItems != null && Model.OrderItems.Any())
        {
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-secondary text-white fw-bold">Items List (Parts)</div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Part Specification</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end pe-4">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold">@item.Part?.PartName</div>
                                            <div class="small text-muted text-uppercase">ID: @item.Part?.PartId</div>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        @* ИСПРАВЛЕНИЕ: Убираем дублирование цены и считаем итог *@
                                        <td class="text-end pe-4 fw-bold text-success">
                                            $@(((item.Part?.PartPrice ?? 0) * item.Quantity).ToString("N2"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>