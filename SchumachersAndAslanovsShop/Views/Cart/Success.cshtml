@{
    ViewData["Title"] = "Order Placed";
}

<div class="container mt-5 text-center">
    <div class="card shadow-lg p-5 border-0 rounded-4 bg-light">
        <div class="mb-3">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
        </div>
        
        <h1 class="fw-bold text-dark">Order placed!</h1>
        <h3 class="text-secondary mb-4">We will contact you!</h3>

        <div class="my-4">
            <img src="https://www.domkrat.by/_domkrat/img/imnews/9-2010/silk_way_final/7351_silk_way_2010.jpg"
                 alt="Hyundai Motorsport Rally Finland"
                 class="img-fluid rounded-3 shadow"
                 style="max-width: 800px; border: 4px solid #000;">
        </div>
        
        <p class="lead text-muted mb-4">Your request is being processed faster than a WRC stage!</p>
        
        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center mt-2">
            <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-dark btn-lg px-5 shadow-sm">
                <i class="bi bi-list-ul me-2"></i>My Orders
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger btn-lg px-5 shadow-sm">
                <i class="bi bi-house-door me-2"></i>Main Menu
            </a>
        </div>
    </div>
</div>